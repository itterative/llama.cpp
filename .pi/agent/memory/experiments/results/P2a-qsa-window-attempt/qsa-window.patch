+// QSA block widths. Nonzero Q4EXP_QSA_WINDOW rounds the block count up to a window so consecutive
+// prefill ubatches share a shape and the graph can be reused; the padded blocks are hidden by the bias,
+// so they only cost work. Prefill only, and only once the selection is saturated: below that the top-k
+// would have to pick a padded block, whose cell entry is 0 and would attend.
+static int64_t qsa_window_tokens() {
+    static const int64_t window_tokens = []() {
+        const char * env = getenv("Q4EXP_QSA_WINDOW");
+        return env ? (int64_t) atoll(env) : 0;
+    }();
+
+    return window_tokens;
+}
+
+static int64_t qsa_blocks_window(int64_t n_blocks, int64_t r, int64_t n_tokens, uint32_t kv_size, int64_t n_sel_max) {
+    const int64_t window_tokens = qsa_window_tokens();
+
+    if (window_tokens <= 0 || n_tokens <= 1 || n_blocks < n_sel_max) {
+        return n_blocks;
+    }
+
+    const int64_t step = std::max<int64_t>(1, window_tokens/r);
+    const int64_t cap  = (kv_size + r - 1)/r;   // pool rows, get_pool asserts on it
+
+    return std::min<int64_t>(GGML_PAD(n_blocks, step), cap);
+}

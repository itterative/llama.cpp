         K->ne[1] >= std::max<int64_t>(4096, 2LL*n_kv_max);
+
+    // Q4EXP_FA_DEBUG: why the gate opened/closed. nb%16 is the 16B alignment the sparse gather needs
+    static const bool fa_gate_debug = std::getenv("Q4EXP_FA_DEBUG") != nullptr;

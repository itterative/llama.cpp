+                (long long) (K->ne[1] % 256),
+                (long long) K->ne[0], (long long) K->ne[1],
+                (long long) Q->ne[0], (long long) Q->ne[1], (long long) Q->ne[2],
+                max_bias, logit_softcap);
+    }
+
+    return gate;
 #endif // !defined(GGML_USE_MUSA)
 }
 
